# Secretos de Edge Functions (PagosYa)
# Copiar a supabase/functions/.env (NO commitear) o cargar con:
#   supabase secrets set --env-file supabase/functions/.env

# Clave global de la plataforma (PagosYa > Integración API). Empieza con spk_
PAGOSYA_PLATFORM_KEY=spk_xxx

# Modo de la pasarela: live (por defecto) | sandbox
# En sandbox se usa PAGOSYA_SANDBOX_KEY y NO se cobra ni se confirma nada.
PAGOSYA_MODE=live

# Clave de pruebas de Checkout Web (empieza con sk_test_). Solo para sandbox.
PAGOSYA_SANDBOX_KEY=sk_test_xxx

# Opcional: sobrescribir los endpoints de PagosYa
# PAGOSYA_SANDBOX_URL=https://nbjwpakpimrqfocsxkda.supabase.co/functions/v1/sandbox-create-checkout

# Secreto del webhook global. Se muestra solo al crearlo o rotarlo.
PAGOSYA_WEBHOOK_SECRET=whsec_xxx

# Secreto compartido con pg_cron para invocar pagosya-reconcile
PAGOSYA_CRON_SECRET=genera-un-valor-aleatorio-largo

# Secreto del webhook de push: el trigger de public.notifications lo envía en
# el header x-push-secret. Debe coincidir con el secreto de Vault
# "push_webhook_secret". Ver docs/push-notifications-setup.md
PUSH_WEBHOOK_SECRET=genera-un-valor-aleatorio-largo

# Orígenes permitidos para CORS (separados por coma). "*" en desarrollo.
PAGOSYA_ALLOWED_ORIGINS=*

# Base de la app para success_url / cancel_url
APP_BASE_URL=https://app.academia.bo

# Opcional: sobrescribir el endpoint de PagosYa
# PAGOSYA_API_URL=https://nbjwpakpimrqfocsxkda.supabase.co/functions/v1/saas-platform
